{
  "name": "smart-city-intelligence-platform",
  "version": "1.0.0",
  "private": true,
  "description": "IntelliCivic: AI Driven Civic Complaint Management and Decision Support Platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run start:dev",
    "build:api": "npm --prefix apps/api run build",
    "prisma:generate": "npm --prefix apps/api run prisma:generate",
    "prisma:studio": "npm --prefix apps/api run prisma:studio"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
