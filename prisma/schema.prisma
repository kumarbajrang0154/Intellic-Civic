// Prisma Schema for IntelliCivic Platform

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  CITIZEN
  DEPARTMENT_HEAD
  DEPARTMENT_OFFICER
  FIELD_WORKER
  ADMIN
  SUPER_ADMIN
}

enum AuthProvider {
  MOBILE_OTP
  GOOGLE
}

enum ComplaintStatus {
  SUBMITTED
  AI_PROCESSING
  PENDING_DEPT_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
  DUPLICATE
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceStage {
  BEFORE
  DURING
  AFTER
}

enum NotificationType {
  COMPLAINT_CREATED
  UNDER_REVIEW
  DEPARTMENT_ASSIGNED
  STATUS_CHANGED
  RESOLVED
  CLOSED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String       @id @default(uuid())
  role         UserRole?
  authProvider AuthProvider
  mobileNumber String?      @unique
  email        String?      @unique
  googleId     String?      @unique
  name         String
  avatarUrl    String?
  isAuthorized Boolean      @default(false)
  isSuspended  Boolean      @default(false)
  lastLoginAt  DateTime?
  departmentId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  complaints             Complaint[]     @relation("CitizenComplaints")
  assignmentsHandled     Assignment[]    @relation("OfficerAssignments")
  assignmentsCreated     Assignment[]    @relation("AssignedBy")
  fieldWorkerAssignments Complaint[]     @relation("FieldWorkerAssignments")
  evidenceUploaded       Evidence[]
  statusChanges          StatusHistory[]
  notifications          Notification[]
  feedbacks              Feedback[]
  auditLogs              AuditLog[]
  refreshTokens          RefreshToken[]

  @@map("users")
}

model OtpRequest {
  id           String   @id @default(uuid())
  mobileNumber String
  otpCode      String
  expiresAt    DateTime
  isVerified   Boolean  @default(false)
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([mobileNumber])
  @@map("otp_requests")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Department {
  id                String   @id @default(uuid())
  name              String   @unique
  description       String   @db.Text
  headOfficeAddress String?  @db.Text
  isSuspended       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users                   User[]
  categories              Category[]
  complaints              Complaint[]    @relation("DepartmentComplaints")
  aiRecommendedComplaints Complaint[]    @relation("AiRecommendedDepartmentComplaints")
  aiPredictions           AiPrediction[]
  fieldWorkers            FieldWorker[]

  @@map("departments")
}

model Category {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String   @db.Text
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  complaints    Complaint[]
  aiPredictions AiPrediction[]

  @@map("categories")
}

model Complaint {
  id                         String          @id @default(uuid())
  ticketId                   String          @unique
  citizenId                  String
  title                      String
  description                String          @db.Text
  status                     ComplaintStatus @default(SUBMITTED)
  priority                   PriorityLevel?
  categoryId                 String?
  departmentId               String?
  aiRecommendedDepartmentId String?
  isVoiceInput               Boolean         @default(false)
  voiceTranscript            String?         @db.Text
  reopenCount                Int             @default(0)
  reopenedAt                 DateTime?
  reopenReason               String?         @db.Text
  resolutionNotes            String?         @db.Text
  /// Note: Null for complaints created before this feature shipped. UI hides override badge if null or matches current category.
  originalCategoryId         String?
  assignedFieldWorkerId      String?
  readyForReview             Boolean         @default(false)
  fieldWorkerRemarks         String?         @db.Text
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  resolvedAt                 DateTime?
  closedAt                   DateTime?

  citizen                 User        @relation("CitizenComplaints", fields: [citizenId], references: [id], onDelete: Restrict)
  category                Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  department              Department? @relation("DepartmentComplaints", fields: [departmentId], references: [id], onDelete: SetNull)
  aiRecommendedDepartment Department? @relation("AiRecommendedDepartmentComplaints", fields: [aiRecommendedDepartmentId], references: [id], onDelete: SetNull)
  assignedFieldWorker     User?       @relation("FieldWorkerAssignments", fields: [assignedFieldWorkerId], references: [id], onDelete: SetNull)

  images             ComplaintImage[]
  location           ComplaintLocation?
  aiPrediction       AiPrediction?
  duplicateMatches   DuplicateMatch[]   @relation("PrimaryComplaint")
  matchedAsDuplicate DuplicateMatch[]   @relation("MatchedComplaint")
  assignment         Assignment?
  evidence           Evidence[]
  statusHistory      StatusHistory[]
  notifications      Notification[]
  feedback           Feedback?

  @@index([status])
  @@index([departmentId])
  @@index([citizenId])
  @@map("complaints")
}

model ComplaintImage {
  id          String   @id @default(uuid())
  complaintId String
  imageUrl    String
  uploadedAt  DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_images")
}

model ComplaintLocation {
  id          String   @id @default(uuid())
  complaintId String   @unique
  latitude    Float
  longitude   Float
  address     String?  @db.Text
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_locations")
}

model AiPrediction {
  id                    String         @id @default(uuid())
  complaintId           String         @unique
  suggestedCategoryId   String?
  suggestedDepartmentId String?
  suggestedPriority     PriorityLevel?
  confidenceScore       Float?
  rawResponse           Json?
  isRejected            Boolean        @default(false)
  createdAt             DateTime       @default(now())

  complaint           Complaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  suggestedCategory   Category?   @relation(fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  suggestedDepartment Department? @relation(fields: [suggestedDepartmentId], references: [id], onDelete: SetNull)

  @@map("ai_predictions")
}

model DuplicateMatch {
  id                 String   @id @default(uuid())
  complaintId        String
  matchedComplaintId String
  similarityScore    Float
  createdAt          DateTime @default(now())

  complaint        Complaint @relation("PrimaryComplaint", fields: [complaintId], references: [id], onDelete: Cascade)
  matchedComplaint Complaint @relation("MatchedComplaint", fields: [matchedComplaintId], references: [id], onDelete: Cascade)

  @@map("duplicate_matches")
}

model Assignment {
  id                  String   @id @default(uuid())
  complaintId         String   @unique
  departmentOfficerId String
  assignedByUserId    String
  assignedAt          DateTime @default(now())
  notes               String?  @db.Text

  complaint         Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  departmentOfficer User      @relation("OfficerAssignments", fields: [departmentOfficerId], references: [id], onDelete: Restrict)
  assignedByUser    User      @relation("AssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@map("assignments")
}

model FieldWorker {
  id           String   @id @default(uuid())
  name         String
  phoneNumber  String
  departmentId String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  evidence   Evidence[]

  @@map("field_workers")
}

model Evidence {
  id               String        @id @default(uuid())
  complaintId      String
  stage            EvidenceStage
  imageUrl         String
  uploadedByUserId String
  fieldWorkerId    String?
  notes            String?       @db.Text
  uploadedAt       DateTime      @default(now())

  complaint      Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  uploadedByUser User         @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  fieldWorker    FieldWorker? @relation(fields: [fieldWorkerId], references: [id], onDelete: SetNull)

  @@map("evidence")
}

model StatusHistory {
  id              String           @id @default(uuid())
  complaintId     String
  fromStatus      ComplaintStatus?
  toStatus        ComplaintStatus
  notes           String?          @db.Text
  changedByUserId String?
  changedAt       DateTime         @default(now())

  complaint     Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  changedByUser User?     @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@map("status_histories")
}

model Notification {
  id              String           @id @default(uuid())
  complaintId     String
  recipientUserId String
  type            NotificationType
  message         String           @db.Text
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())

  complaint     Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  recipientUser User      @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId])
  @@map("notifications")
}

model Feedback {
  id          String   @id @default(uuid())
  complaintId String   @unique
  citizenId   String
  rating      Int
  comment     String?  @db.Text
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  citizen   User      @relation(fields: [citizenId], references: [id], onDelete: Restrict)

  @@map("feedbacks")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}

model PlatformSettings {
  id                    String   @id @default("global")
  // 1. General Branding
  platformName          String   @default("IntelliCivic Platform")
  shortName             String   @default("IntelliCivic")
  organizationName      String   @default("Smart City Municipal Corporation")
  logoUrl               String?  @db.Text
  faviconUrl            String?  @db.Text

  // 2. Contact Information
  supportEmail          String   @default("support@intellicivic.gov.in")
  officialPhone         String   @default("+91 1800-123-4567")
  citizenSupportNumber  String   @default("+91 1800-111-2222")
  officeContactNumber   String   @default("+91 011-23456789")
  workingHours          String   @default("Mon - Sat: 9:00 AM - 6:00 PM")

  // 3. Organization Address
  officeName            String   @default("Civic Center HQ")
  address               String   @default("1, Municipal Circle, Connaught Place")
  city                  String   @default("New Delhi")
  district              String   @default("Central Delhi")
  state                 String   @default("Delhi")
  pincode               String   @default("110001")
  country               String   @default("India")

  // 4. Google Maps
  googleMapsUrl         String?  @db.Text
  latitude              Float?   @default(28.6315)
  longitude             Float?   @default(77.2167)

  // 5. Social Links
  websiteUrl            String?  @default("https://smartaicity.vercel.app")
  facebookUrl           String?  @default("https://facebook.com/intellicivic")
  instagramUrl          String?  @default("https://instagram.com/intellicivic")
  twitterUrl            String?  @default("https://x.com/intellicivic")
  linkedinUrl           String?  @default("https://linkedin.com/company/intellicivic")
  youtubeUrl            String?  @default("https://youtube.com/@intellicivic")

  // 6. Footer Settings
  footerDescription     String   @default("Empowering citizens and municipal administration with AI-driven civic complaint resolution, transparent tracking, and automated field governance.") @db.Text
  copyrightText         String   @default("© 2026 IntelliCivic Smart City Platform. All rights reserved.")

  // 7. Legal Settings
  privacyPolicyUrl      String?  @default("/privacy") @db.Text
  termsConditionsUrl    String?  @default("/terms") @db.Text

  // 8. SEO & Meta
  metaTitle             String   @default("IntelliCivic - AI Driven Smart City Civic Platform")
  metaDescription       String   @default("Report civic complaints, track real-time resolution, and connect with municipal departments efficiently.") @db.Text
  metaKeywords          String   @default("smart city, civic complaint, municipal governance, pothole repair, sanitation, AI triage")
  openGraphImageUrl     String?  @db.Text

  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@map("platform_settings")
}

model SlaRule {
  id              String        @id @default(uuid())
  priority        PriorityLevel @unique
  resolutionHours Int           /// Resolution time in hours (e.g. 24, 72, 168)
  label           String        /// Human-readable label e.g. "24 hours", "3 days"
  isActive        Boolean       @default(true)
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())

  @@map("sla_rules")
}
