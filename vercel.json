{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/sla-escalation",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/scheduled-reports",
      "schedule": "0 4 * * *"
    }
  ]
}
