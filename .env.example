# ==========================================
# IntelliCivic Platform - Root Environment Template (.env.example)
# All environment variables live in this single root-level file.
# Copy this file to .env at the repo root: `cp .env.example .env`
# ==========================================

# Database Credentials
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NestJS Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN=7d

# Google OAuth Credentials (Staff Login)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/staff/google/callback"

# Super Admin Bootstrap
SUPER_ADMIN_BOOTSTRAP_EMAIL="admin@example.com"

# OTP Configuration
OTP_AUTH_MODE="console"
OTP_PROVIDER_API_KEY="otp_key_placeholder"
OTP_PROVIDER_SENDER_ID="CIVIC"

# Next.js Web App Public Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_OTP_AUTH_MODE="console"

# Firebase Client SDK Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID="your_project_id"
FIREBASE_CLIENT_EMAIL="your_client_email"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# AI Service Configuration
AI_SERVICE_URL="http://localhost:8000"
GEMINI_API_KEY="your_gemini_api_key_here"
AI_SERVICE_PORT=8000
AI_SERVICE_HOST="0.0.0.0"
