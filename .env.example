# ==========================================
# IntelliCivic Platform - Environment Template (.env.example)
# All environment variables live in this single root-level file.
# Copy this file to .env at the repo root.
# ==========================================

# Database Credentials (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Next.js Server Configuration
NODE_ENV=development
ENABLE_DEV_LOGIN="true"
JWT_SECRET="intellicivic-super-secret-jwt-key-2026"
JWT_EXPIRES_IN=7d

# Google OAuth Credentials (Staff Login)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CALLBACK_URL="https://your-domain.vercel.app/api/auth/google/callback"
NEXT_PUBLIC_FRONTEND_URL="https://your-domain.vercel.app"

# Super Admin Bootstrap
SUPER_ADMIN_BOOTSTRAP_EMAIL="admin@example.com"

# OTP Configuration (console = prototype testing, firebase = real SMS)
OTP_AUTH_MODE="console"
NEXT_PUBLIC_OTP_AUTH_MODE="console"

# Firebase Client SDK Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID="your_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@your_project_id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# AI Service Configuration
AI_SERVICE_URL="http://localhost:8000"
GEMINI_API_KEY="your_gemini_api_key_here"
