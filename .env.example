# ==========================================
# IntelliCivic Platform - Environment Template (.env.example)
# All environment variables live in this single root-level file.
# Copy this file to .env at the repo root.
# ==========================================

# Database Credentials (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Test Database Safety Guard (Host only - no credentials or full URLs)
# Must match the host component of DATABASE_URL to permit e2e tests or prisma/seed.ts execution.
TEST_DATABASE_HOST="ep-your-test-db-pooler.c-2.us-east-2.aws.neon.tech"
# Production Database Deny-List Guard (Host only - no credentials or full URLs)
# If DATABASE_URL matches this host, test scripts, seeds, and migrations immediately abort with exit code 1.
# PRODUCTION_DB_HOST="ep-your-prod-pooler.c-2.us-east-2.aws.neon.tech"

# Next.js / Server Configuration
NODE_ENV=development
# VERCEL_ENV="development" # Automated on Vercel deployment: development, preview, production
JWT_SECRET="intellicivic-super-secret-jwt-key-2026"

# Google OAuth Credentials (Staff Login)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
NEXT_PUBLIC_FRONTEND_URL="https://your-domain.vercel.app"

# Root Admin & Super Admin Configuration
ROOT_ADMIN_EMAIL="kumarbajrang325@gmail.com"
SUPER_ADMIN_BOOTSTRAP_EMAIL="kumarbajrang325@gmail.com"

# OTP Configuration (console = prototype testing with in-console code, firebase = real SMS via Firebase Phone Auth)
# Set both to "firebase" for production. Set to "console" for local dev without Firebase credentials.
OTP_AUTH_MODE="firebase"
NEXT_PUBLIC_OTP_AUTH_MODE="firebase"
# Optional allowlisted demo numbers and fixed 6-digit OTP code for testing
# DEMO_OTP_NUMBERS="9999999999"
# DEMO_OTP_CODE="123456"

# Cloudinary Storage Configuration (Optional - falls back to Data URLs if unconfigured)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Firebase Client SDK Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"

# Firebase Admin SDK Credentials (server-side only — NEVER expose in client code or commit to git)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Download the JSON file. Use the "project_id", "client_email", and "private_key" fields.
# Paste private_key as a single-line string with \n (backslash-n) in place of actual newlines.
FIREBASE_PROJECT_ID="your_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@your_project_id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_body_here\n-----END PRIVATE KEY-----\n"

# AI Service Configuration (Primary: Gemini, Secondary/Failover: Groq)
AI_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.1-flash-lite"

# Second AI Provider Configuration (Groq - Fast free-tier failover provider)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"

# Upstash Redis Rate Limiting Configuration (Optional)
# Serverless Redis for distributed sliding-window rate limiting. If unconfigured,
# IntelliCivic automatically falls back to Neon Postgres-backed atomic rate limiting.
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# Rate Limit HMAC Secret (Required in production for hashing mobile numbers in OTP rate limit keys)
RATE_LIMIT_HMAC_SECRET="your_rate_limit_hmac_secret_here"

# Phase 1 Cron & Email Notification Configuration
# Secret verified via timingSafeEqual by GET/POST /api/cron/sla-escalation (Vercel sets Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="your_cron_secret_here"
# Resend HTTP API key & sender address (optional in local dev; missing key logs non-PII warning & skips email safely)
RESEND_API_KEY="your_resend_api_key_here"
EMAIL_FROM="IntelliCivic <notifications@intellicivic.gov.in>"
# Separate HMAC secret for hashing email recipients in email_deliveries (falls back safely if unset in dev)
EMAIL_HMAC_SECRET="your_email_hmac_secret_here"
# Base app URL used in email deep links (set NEXT_PUBLIC_FRONTEND_URL above, e.g. https://your-domain.vercel.app)

# Sentry Error & Performance Monitoring
# Client and Server DSNs for production error tracking and AI fallback event reporting
SENTRY_DSN="https://your_sentry_key@o000000.ingest.sentry.io/0000000"
NEXT_PUBLIC_SENTRY_DSN="https://your_sentry_key@o000000.ingest.sentry.io/0000000"
# Sentry Build & Release Uploads (Optional, CI/CD only)
# SENTRY_ORG="your-sentry-org"
# SENTRY_PROJECT="intellicivic"
# SENTRY_AUTH_TOKEN="your_sentry_auth_token"

# Admin 2FA (TOTP) Encryption Key (Optional - falls back to JWT_SECRET if unset)
# TOTP_ENCRYPTION_KEY="your_totp_encryption_key_here"

# Multi-Channel Citizen Notifications (Optional - safely skips & logs status if unconfigured)
# WhatsApp Cloud API (Meta Graph API)
# WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
# WHATSAPP_ACCESS_TOKEN="your_whatsapp_access_token"
# MSG91 Flow SMS Notifications
# MSG91_AUTH_KEY="your_msg91_auth_key"
# MSG91_NOTIFY_FLOW_ID="your_msg91_notify_flow_id"
# MSG91_TEMPLATE_ID="your_msg91_template_id"
# MSG91_SENDER_ID="your_msg91_sender_id"
# Web Push Relay Endpoint
# WEB_PUSH_RELAY_URL="https://your-web-push-relay.example.com/send"

# Public Civic API Protection (Optional - /api/public/v1/* stays open when unset)
# When set, callers must pass x-api-key: <PUBLIC_API_KEY> or Authorization: Bearer <PUBLIC_API_KEY>
# PUBLIC_API_KEY="your_public_api_key"

